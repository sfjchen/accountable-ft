.env
outputs/
__pycache__/
.venv/
*.log
.DS_Store
# over GitHub limits: raw v1 (the .gz is committed), the old v1.0, the Gemini cache (tarball on the data-v1 release)
data/v1.jsonl
data/mortgage.jsonl
data/mortgage-split.jsonl
data/permit.jsonl
data/mortgage.smoke.jsonl
data/v1.0.jsonl
data/.gemini_cache/
data/snap.jsonl
data/dependent.jsonl
data/*-x.jsonl
# response caches: the cluster answer caches (the run files hold the answers), and the simulator caches, committed as
# .gz since GitHub refuses files over 100 MB
runs/cache.*.jsonl
runs/cache.jsonl
runs/cache-opus.jsonl
runs/eval.json
# cluster job logs and compile caches, so a job's git add runs never commits them
runs/slurm/
unsloth_compiled_cache/
